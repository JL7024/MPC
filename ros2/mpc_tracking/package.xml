<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mpc_tracking</name>
  <version>0.1.0</version>
  <description>
    MPC 轨迹跟踪仿真的 ROS2 封装: 仿真 / 规划 / EKF 估计 / 控制拆成独立节点,
    topic 通信, launch 统一启动, RViz2 显示参考轨迹与 MPC 预测时域。
    算法直接复用仓库根目录下的 Python 模块。
  </description>
  <maintainer email="jl7024@todo.todo">JL7024</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>mpc_tracking_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
